rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.uid == userId
        && data.username is string && data.username.size() <= 40
        && data.bio is string && data.bio.size() <= 150
        && data.neurotypes is list && data.neurotypes.size() <= 15
        && (!data.keys().hasAny(['interestMedia']) || (data.interestMedia is list && data.interestMedia.size() <= 12))
        && (!data.keys().hasAny(['communityVisible']) || data.communityVisible is bool)
        && data.links is list && data.links.size() <= 6
        && (!data.keys().hasAny(['avatar']) || data.avatar == null
          || (data.avatar is string && data.avatar.size() <= 340000));
    }

    match /users/{userId} {
      // Owners always have access; other signed-in members can query only explicit opt-ins.
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'avatar', 'bio', 'neurotypes', 'links', 'lastUsernameChange', 'updatedAt', 'interestMedia', 'communityVisible'
        ])
        && validProfile(request.resource.data, userId);
      allow update: if signedInAs(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'avatar', 'bio', 'neurotypes', 'links', 'lastUsernameChange', 'updatedAt', 'interestMedia', 'communityVisible'
        ]);
      allow delete: if false;
    }

    match /communityProfiles/{userId} {
      // This projection contains only fields the member chose to share.
      allow get: if request.auth != null && resource.data.profileVisible == true
        && get(/databases/$(database)/documents/users/$(userId)).data.communityVisible == true;
      allow list: if false;
      allow create, update: if signedInAs(userId)
        && request.resource.data.uid == userId
        && request.resource.data.visible == true
        && request.resource.data.profileVisible is bool
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 40
        && request.resource.data.interestMedia is list
        && request.resource.data.interestMedia.size() <= 12
        && request.resource.data.keys().hasOnly([
          'uid', 'visible', 'profileVisible', 'username', 'avatar', 'bio',
          'neurotypes', 'links', 'interestMedia', 'sharedPostIds', 'updatedAt'
        ]);
      allow delete: if signedInAs(userId);
    }

    match /galleryEngagement/{ownerId}/posts/{postId} {
      function isSharedPost() {
        return request.auth != null
          && get(/databases/$(database)/documents/users/$(ownerId)).data.communityVisible == true
          && exists(/databases/$(database)/documents/communityProfiles/$(ownerId))
          && get(/databases/$(database)/documents/communityProfiles/$(ownerId)).data.profileVisible == true
          && get(/databases/$(database)/documents/communityProfiles/$(ownerId)).data.keys().hasAll(['sharedPostIds'])
          && get(/databases/$(database)/documents/communityProfiles/$(ownerId)).data.sharedPostIds is map
          && get(/databases/$(database)/documents/communityProfiles/$(ownerId)).data.sharedPostIds.keys().hasAny([postId]);
      }

      match /likes/{userId} {
        allow read: if isSharedPost() || signedInAs(ownerId);
        allow create: if isSharedPost() && signedInAs(userId)
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == userId;
        allow delete: if signedInAs(userId) || signedInAs(ownerId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSharedPost() || signedInAs(ownerId);
        allow create: if isSharedPost()
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'text', 'createdAt', 'replyTo', 'replyToName'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && ((!request.resource.data.keys().hasAny(['replyTo', 'replyToName']))
            || (request.resource.data.keys().hasAll(['replyTo', 'replyToName'])
              && request.resource.data.replyTo is string
              && request.resource.data.replyToName is string
              && exists(/databases/$(database)/documents/galleryEngagement/$(ownerId)/posts/$(postId)/comments/$(request.resource.data.replyTo))
              && request.resource.data.replyToName == get(/databases/$(database)/documents/galleryEngagement/$(ownerId)/posts/$(postId)/comments/$(request.resource.data.replyTo)).data.authorName));
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.uid || request.auth.uid == ownerId);
        allow update: if isSharedPost() && signedInAs(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      }
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // Orders and payment state are written only by the verified Stripe webhook.
      allow write: if false;
    }
  }
}
